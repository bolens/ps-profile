{
  "powershell.powerShellDefaultVersion": "PowerShell",
  "powershell.enableProfileLoading": false,
  "powershell.scriptAnalysis.enable": true,
  "powershell.scriptAnalysis.settingsPath": "PSScriptAnalyzerSettings.psd1",
  "[powershell]": {
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "ms-vscode.powershell"
  },
  "files.associations": {
    "*.ps1": "powershell",
    "*.psd1": "powershell",
    "*.psm1": "powershell"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/Modules/*/": false
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/Modules/": true,
    "**/.git": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.devenv": true,
    "**/.direnv": true
  },
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "[markdown]": {
    "files.trimTrailingWhitespace": false,
    "editor.wordWrap": "on"
  },
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[json]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[jsonc]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.trimAutoWhitespace": true,
  "editor.renderWhitespace": "boundary",
  "editor.wordWrap": "on",
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "cSpell.language": "en",
  "cSpell.enabled": true,
  "cSpell.words": [
    "PowerShell",
    "PSScriptAnalyzer",
    "Pester",
    "platyPS",
    "git-cliff",
    "semantic-release"
  ],
  "task.quickOpen.detail": true,
  "task.quickOpen.showAll": true,
  "kiroAgent.configureMCP": "Disabled",
  "makefile.configureOnOpen": false,
  "dbcode.connections": [
    {
      "connectionId": "D7NTCf1t9pqD_Fm1MlsUo",
      "name": "fragment-cache",
      "driver": "sqlite",
      "connectionType": "socket",
      "socket": "PowerShell/.cache/fragment-cache.db",
      "readOnly": false,
      "postConnectionSqlType": "inline",
      "driverOptions": {
        "extensions": []
      },
      "idleTimeout": 0
    }
  ],
  "files.watcherExclude": {
    "**/.devenv/**": true,
    "**/.direnv/**": true,
    "**/.venv/**": true
  },
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell"
    }
  },
  "terminal.integrated.profiles.linux": {
    "PowerShell": {
      "path": "pwsh",
      "args": [
        "-NoProfile"
      ]
    }
  }
}
