#!/bin/sh
# Tracked shim. To enable, create an empty file at .hooks/enable.
set -eu

[ -f .hooks/enable ] || exit 0

root=$(git rev-parse --show-toplevel)
cd "$root"
git diff --cached --check

project_change=0
spec_change=0
staged_list=${TMPDIR:-/tmp}/ps-profile-staged.$$
git diff --cached --name-only --diff-filter=ACMR >"$staged_list"
while IFS= read -r file; do
  case "$file" in
    .agents/skills/speckit-*|.specify/*) spec_change=1 ;;
    *) project_change=1 ;;
  esac
done <"$staged_list"
rm -f "$staged_list"

if [ "$spec_change" -eq 1 ]; then
  git diff --cached --name-only --diff-filter=ACMR -- '.specify/scripts/bash/*.sh' |
    while IFS= read -r file; do bash -n "$file"; done
  if command -v specify >/dev/null 2>&1; then
    specify integration status >/dev/null
  fi
fi

[ "$project_change" -eq 1 ] || exit 0

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/git/pre-commit.ps1
fi
if command -v powershell >/dev/null 2>&1; then
  exec powershell -NoProfile -ExecutionPolicy Bypass -File scripts/git/pre-commit.ps1
fi

echo 'PowerShell is required for project-source pre-commit checks.' >&2
exit 1
